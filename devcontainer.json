// VS Code Dev Container for the ABIDES "Build and Battle Your Trading Agent" lab.
// One-click setup: open the folder in VS Code, then "Reopen in Container".
//
// This wires VS Code to the same Dockerfile used by `docker compose up`, but
// keeps the container alive for interactive use rather than starting JupyterLab.
{
    "name": "ABIDES Lab",

    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },

    // Mount the repo as the workspace; source edits flow through to the
    // editable installs inside the container.
    "workspaceFolder": "/abides",
    "workspaceMount": "source=${localWorkspaceFolder},target=/abides,type=bind,consistency=cached",

    // Run as the non-root user defined in the Dockerfile.
    "remoteUser": "abides",

    // Override the image CMD so the container stays alive for shell access
    // instead of foregrounding JupyterLab. Use `make up` or `docker compose up`
    // when you specifically want the Jupyter server.
    "overrideCommand": true,

    "forwardPorts": [8888],
    "portsAttributes": {
        "8888": {
            "label": "JupyterLab",
            "onAutoForward": "ignore"
        }
    },

    // After the container is created, ensure the three sub-packages are
    // installed in editable mode against the bind-mounted source (the image
    // does this too, but rerunning is cheap and covers fresh clones).
    "postCreateCommand": "bash .devcontainer/postCreate.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.terminal.activateEnvironment": false,
                "jupyter.notebookFileRoot": "${workspaceFolder}",
                "files.eol": "\n"
            }
        }
    }
}
